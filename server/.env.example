# === AI Legal Ecosystem — Environment Variables ===

# LLM Configuration
LLM_PROVIDER=gemini          # Options: gemini, openai, ollama
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash

# n8n Integration (For Real-Time Web Search)
# Create a webhook in n8n and paste the Production URL here
N8N_ANALYSIS_WEBHOOK=https://your-n8n-instance.com/webhook/legal-analysis

# Database Configuration
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/legal_services
# Falls back to SQLite if MySQL is unavailable

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27018
MONGODB_NAME=legal_services

# Security
SECRET_KEY=your-secret-key-change-in-production
